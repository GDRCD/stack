#!/usr/bin/env bash
# @cli.summary: Esporta un database in un dump SQL
# @cli.usage: [OPTIONS...] DATABASE [FILE]
# @cli.option: -c, --compress | flag | | Comprime il dump esportato
# @cli.argument: DATABASE | text | required | Nome del database
# @cli.argument: FILE | file | optional | File .sql di destinazione

importLib "lib/lib-docker.sh"
shift
COMPRESS="false"; DATABASE_NAME=""; FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -c | --compress) COMPRESS="true"; shift ;;
    *) if [[ -z "${DATABASE_NAME}" ]]; then DATABASE_NAME="$1"; elif [[ -z "${FILE}" ]]; then FILE="$1"; else messageUnknownCommand export "$1"; exit 2; fi; shift ;;
  esac
done
[[ "${DATABASE_NAME}" =~ ^[[:alnum:]_]+$ ]] || { prompt -e "Nome database non valido."; exit 2; }
FILE="${FILE:-${DATABASE_NAME}.sql}"
[[ "${FILE}" == *.sql ]] || { prompt -e "Il file deve avere estensione .sql."; exit 2; }
OUTPUT="${FILE}"; [[ "${COMPRESS}" != "true" ]] || OUTPUT="${FILE}.gz"
OUTPUT_DIR="$(dirname "${OUTPUT}")"
[[ -d "${OUTPUT_DIR}" && -w "${OUTPUT_DIR}" ]] || { prompt -e "Directory di destinazione non scrivibile."; exit 1; }
isContainerExist database; isContainerRunning database
TEMP_SQL="$(mktemp "${OUTPUT_DIR}/.$(basename "${OUTPUT}").XXXXXX")"
TEMP_OUTPUT="${TEMP_SQL}"
trap 'rm -f -- "${TEMP_SQL}" "${TEMP_OUTPUT}"' EXIT
prompt -i "Esportazione di ${DATABASE_NAME} in ${OUTPUT}..."
dockerCompose exec -T -e "MYSQL_PWD=${MYSQL_ROOT_PASSWORD}" database \
  mysqldump --routines -uroot "${DATABASE_NAME}" >"${TEMP_SQL}"
if [[ "${COMPRESS}" == "true" ]]; then TEMP_OUTPUT="${TEMP_SQL}.gz"; gzip -c -- "${TEMP_SQL}" >"${TEMP_OUTPUT}"; fi
mv -f -- "${TEMP_OUTPUT}" "${OUTPUT}"
rm -f -- "${TEMP_SQL}"
trap - EXIT
prompt -s "Dump creato: ${OUTPUT}"
