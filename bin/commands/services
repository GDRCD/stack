#!/usr/bin/env bash
# @cli.summary: Elenca i servizi opzionali e il loro stato
# @cli.usage:

shift
[[ $# -eq 0 ]] || { messageUnknownCommand services "$1"; exit 2; }
for SERVICE_NAME in "${OPTIONAL_SERVICES[@]}"; do
  STATUS="disabilitato"; isServiceEnabled "${SERVICE_NAME}" && STATUS="abilitato"
  helpify "${SERVICE_NAME}" "$(serviceDescription "${SERVICE_NAME}")" "${STATUS}"
done
