#!/usr/bin/env bash
# @cli.summary: Riavvia tutti i container o quelli indicati
# @cli.usage: [SERVICE...]
# @cli.argument: SERVICE... | service | repeatable | Servizi da riavviare

importLib "lib/lib-docker.sh"
shift
SERVICE_NAMES=("$@")
for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isServiceEnabled "${SERVICE_NAME}" || { messageUnknownCommand restart "${SERVICE_NAME}"; exit 2; }; done
if [[ ${#SERVICE_NAMES[@]} -eq 0 ]]; then isContainerExist; dockerCompose restart; else
  for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isContainerExist "${SERVICE_NAME}"; dockerCompose restart "${SERVICE_NAME}"; done
fi
