#!/usr/bin/env bash
# @cli.summary: Cambia la shell corrente verso www o la root dello stack
# @cli.usage: [--root]
# @cli.option: --root | flag | | Usa la directory principale invece di www

shift
TARGET="${WWW_DIR}"
while [[ $# -gt 0 ]]; do
  case "$1" in --root) TARGET="${STACK_DIR}"; shift ;; *) messageUnknownCommand cd "$1"; exit 2 ;; esac
done
[[ -d "${TARGET}" ]] || { prompt -e "Directory non trovata: ${TARGET}"; exit 1; }
cd "${TARGET}" || exit
pwd -P
