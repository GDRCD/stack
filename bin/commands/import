#!/usr/bin/env bash
# @cli.summary: Importa un dump SQL in un database
# @cli.usage: [OPTIONS...] DATABASE FILE
# @cli.option: -f, --force-drop | flag | | Elimina e ricrea il database prima dell'import
# @cli.argument: DATABASE | text | required | Nome del database
# @cli.argument: FILE | file | required | Dump .sql o .sql.gz

importLib "lib/lib-docker.sh"
shift
FORCE_DROP="false"; DATABASE_NAME=""; FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -f | --force-drop) FORCE_DROP="true"; shift ;;
    *) if [[ -z "${DATABASE_NAME}" ]]; then DATABASE_NAME="$1"; elif [[ -z "${FILE}" ]]; then FILE="$1"; else messageUnknownCommand import "$1"; exit 2; fi; shift ;;
  esac
done
[[ "${DATABASE_NAME}" =~ ^[[:alnum:]_]+$ ]] || { prompt -e "Nome database non valido."; exit 2; }
[[ -f "${FILE}" && "${FILE}" =~ \.(sql|sql\.gz)$ ]] || { prompt -e "È richiesto un file .sql o .sql.gz esistente."; exit 2; }
isContainerExist database; isContainerRunning database
if [[ "${FORCE_DROP}" == "true" ]]; then
  dockerCompose exec -T -e "MYSQL_PWD=${MYSQL_ROOT_PASSWORD}" database mysql -uroot \
    -e "DROP DATABASE IF EXISTS \`${DATABASE_NAME}\`; CREATE DATABASE \`${DATABASE_NAME}\`;"
fi
prompt -i "Importazione di ${FILE} in ${DATABASE_NAME}..."
if [[ "${FILE}" == *.gz ]]; then
  gzip -dc -- "${FILE}" | dockerCompose exec -T -e "MYSQL_PWD=${MYSQL_ROOT_PASSWORD}" database mysql -uroot "${DATABASE_NAME}"
else
  dockerCompose exec -T -e "MYSQL_PWD=${MYSQL_ROOT_PASSWORD}" database mysql -uroot "${DATABASE_NAME}" <"${FILE}"
fi
prompt -s "Import completato."
