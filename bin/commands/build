#!/usr/bin/env bash
# @cli.summary: Costruisce tutti i container o quelli indicati
# @cli.usage: [OPTIONS...] [SERVICE...]
# @cli.option: -f, --force | flag | | Ricostruisce senza usare la cache Docker
# @cli.argument: SERVICE... | service | repeatable | Servizi da costruire

importLib "lib/lib-docker.sh"
shift
FORCE_BUILD="false"
SERVICE_NAMES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -f | --force) FORCE_BUILD="true"; shift ;;
    *) isServiceEnabled "$1" || { messageUnknownCommand build "$1"; exit 2; }; SERVICE_NAMES+=("$1"); shift ;;
  esac
done
BUILD_OPTIONS=()
[[ "${FORCE_BUILD}" != "true" ]] || BUILD_OPTIONS+=(--no-cache)
if [[ ${#SERVICE_NAMES[@]} -eq 0 ]]; then
  prompt -i "Costruzione di tutti i container..."
  dockerCompose rm -s -f && dockerCompose build "${BUILD_OPTIONS[@]}" && dockerCompose up -d
else
  for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do
    prompt -i "Costruzione del servizio ${SERVICE_NAME}..."
    dockerCompose rm -s -f "${SERVICE_NAME}" && dockerCompose build "${BUILD_OPTIONS[@]}" "${SERVICE_NAME}" && dockerCompose up -d "${SERVICE_NAME}"
  done
fi
