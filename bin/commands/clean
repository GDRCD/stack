#!/usr/bin/env bash
# @cli.summary: Rimuove container e risorse dello stack
# @cli.usage: [OPTIONS...]
# @cli.option: -v, --volumes | flag | | Rimuove anche i volumi persistenti

importLib "lib/lib-docker.sh"
shift
CLEAN_VOLUMES="false"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --volumes) CLEAN_VOLUMES="true"; shift ;;
    *) messageUnknownCommand clean "$1"; exit 2 ;;
  esac
done
OPTIONS=(--remove-orphans)
[[ "${CLEAN_VOLUMES}" != "true" ]] || OPTIONS+=(-v)
prompt -i "Rimozione delle risorse dello stack..."
dockerCompose down "${OPTIONS[@]}"
