#!/usr/bin/env bash
# @cli.summary: Elimina e ricrea un database vuoto
# @cli.usage: [OPTIONS...] DATABASE
# @cli.option: -y, --yes | flag | | Non chiede conferma
# @cli.argument: DATABASE | text | required | Nome del database

importLib "lib/lib-docker.sh"
shift
ASSUME_YES="false"; DATABASE_NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y | --yes) ASSUME_YES="true"; shift ;;
    *) [[ -z "${DATABASE_NAME}" ]] || { messageUnknownCommand refresh "$1"; exit 2; }; DATABASE_NAME="$1"; shift ;;
  esac
done
[[ "${DATABASE_NAME}" =~ ^[[:alnum:]_]+$ ]] || { prompt -e "Nome database non valido."; exit 2; }
if [[ "${ASSUME_YES}" != "true" ]]; then
  [[ -t 0 ]] || { prompt -e "Usa --yes in un contesto non interattivo."; exit 2; }
  read -r -p "Eliminare e ricreare '${DATABASE_NAME}'? [y/N] " CONFIRM
  case "${CONFIRM}" in y | Y | yes | YES) ;; *) prompt -w "Operazione annullata."; exit 0 ;; esac
fi
isContainerExist database; isContainerRunning database
dockerCompose exec -T -e "MYSQL_PWD=${MYSQL_ROOT_PASSWORD}" database mysql -uroot \
  -e "DROP DATABASE IF EXISTS \`${DATABASE_NAME}\`; CREATE DATABASE \`${DATABASE_NAME}\`;"
prompt -s "Database ${DATABASE_NAME} ricreato."
