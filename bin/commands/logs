#!/usr/bin/env bash
# @cli.summary: Mostra i log di tutti i container o di quelli indicati
# @cli.usage: [SERVICE...]
# @cli.argument: SERVICE... | service | repeatable | Servizi di cui mostrare i log

importLib "lib/lib-docker.sh"
shift
SERVICE_NAMES=("$@")
for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isServiceEnabled "${SERVICE_NAME}" || { messageUnknownCommand logs "${SERVICE_NAME}"; exit 2; }; done
if [[ ${#SERVICE_NAMES[@]} -eq 0 ]]; then
  isContainerExist; isContainerRunning
  dockerCompose logs -f -t
else
  for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isContainerExist "${SERVICE_NAME}"; isContainerRunning "${SERVICE_NAME}"; dockerCompose logs -f -t "${SERVICE_NAME}"; done
fi
