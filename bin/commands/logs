#!/usr/bin/env bash

importLib "lib/lib-docker.sh"

# ---------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------

# Get current file name
CURRENT_FILE_NAME="$(basename "${BASH_SOURCE[0]}")"

# Save command name
args=("$@")
COMMAND_NAME="${args[0]}"
SERVICE_NAMES=()
# ---------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------

# Function for showing usage of this command
usage() {
  helpify_title "logs" "[OPTIONS...] [<service>...]"
  helpify_subtitle "Show all containers log or only the specified ones";
  echo
  helpify_subtitle "OPTIONS:"
  helpify "-h, --help" "Show this help"
}

# Function for showing usage of this command for help
usage4help() {
  helpify "logs" "Show all containers log or only the specified ones";
}

# ---------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------

#---------------------------PARSE ARGUMENTS-------------------------------#

# Parse arguments
while [[ $# -gt 0 ]]; do
  # if the argument is the command name, skip it
  if [[ "$1" == "${COMMAND_NAME}" || "$1" == "${SERVICE_NAME}" ]]; then
    shift
    continue
  fi

  #
  case "$1" in
  -h | --help)
    need_help="true"
    shift
    ;;
  *)
    if isServiceEnabled "$1"; then
      SERVICE_NAMES+=("$1")
      shift
    else
      messageUnknownCommand "$COMMAND_NAME" "$1"
      exit 1
    fi
    ;;
  esac
done

# Execute post argument parsing checks
finalize_argument_parsing

#---------------------------RUN COMMAND-------------------------------#

logs() {

  if [[ ${#SERVICE_NAMES[@]} -eq 0 ]]; then
    # Preliminary checks
    isContainerExist
    isContainerRunning
    prompt -i "Getting all containers logs..."
    dockerCompose logs -f -t
  else
    for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do
      isContainerExist "${SERVICE_NAME}"
      isContainerRunning "${SERVICE_NAME}"
      prompt -i "Getting ${SERVICE_NAME} container logs... \n"
      dockerCompose logs -f -t "${SERVICE_NAME}"
    done
  fi
}

# Run command if this file is the command file
if [[ "${COMMAND_NAME}" == "${CURRENT_FILE_NAME}" ]]; then
  logs
fi
