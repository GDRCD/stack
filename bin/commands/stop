#!/usr/bin/env bash
# @cli.summary: Ferma tutti i container o quelli indicati
# @cli.usage: [SERVICE...]
# @cli.argument: SERVICE... | service | repeatable | Servizi da fermare

importLib "lib/lib-docker.sh"
shift
SERVICE_NAMES=("$@")
for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isServiceEnabled "${SERVICE_NAME}" || { messageUnknownCommand stop "${SERVICE_NAME}"; exit 2; }; done
if [[ ${#SERVICE_NAMES[@]} -eq 0 ]]; then isContainerExist; dockerCompose stop; else
  for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isContainerExist "${SERVICE_NAME}"; dockerCompose stop "${SERVICE_NAME}"; done
fi
