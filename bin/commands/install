#!/usr/bin/env bash
# @cli.summary: Installa il comando globale
# @cli.usage: [OPTIONS...]
# @cli.option: -t, --target | directory | PATH | Directory di installazione
# @cli.option: -f, --force | flag | | Sostituisce una precedente installazione dello stesso stack
# @cli.option: --activate | flag | | Attiva PATH, completion e cd nella shell predefinita

importLib "lib/lib-shell-integration.sh"
shift
if [[ "$(id -u)" -eq 0 ]]; then TARGET_DEFAULT="/usr/local/bin"; else TARGET_DEFAULT="${HOME}/.local/bin"; fi
TARGET="${TARGET_DEFAULT}"; FORCE="false"; ACTIVATE="false"; SHELL_NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -t | --target) require_option_value "$1" "${2:-}" || exit $?; TARGET="$2"; shift 2 ;;
    -f | --force) FORCE="true"; shift ;;
    --activate) ACTIVATE="true"; shift ;;
    *) messageUnknownCommand install "$1"; exit 2 ;;
  esac
done

if [[ "${ACTIVATE}" == "true" ]]; then
  SHELL_NAME="${SHELL##*/}"
  case "${SHELL_NAME}" in bash | zsh) ;; *) prompt -e "Shell non supportata: ${SHELL_NAME:-sconosciuta}"; exit 2 ;; esac
fi

FINAL_NAME="${PROJECT:-stack}"
validate_shell_integration_name "${FINAL_NAME}" || { prompt -e "Nome comando non valido: ${FINAL_NAME}"; exit 2; }
mkdir -p -- "${TARGET}"
TARGET="$(cd -P "${TARGET}" && pwd)"
[[ -w "${TARGET}" ]] || { prompt -e "Directory non scrivibile: ${TARGET}"; exit 1; }
DESTINATION="${TARGET}/${FINAL_NAME}"
if [[ -e "${DESTINATION}" || -L "${DESTINATION}" ]]; then
  [[ "${FORCE}" == "true" ]] || { prompt -e "${DESTINATION} esiste già; usa --force."; exit 1; }
  [[ -L "${DESTINATION}" ]] || { prompt -e "Rifiuto di sostituire un file non simbolico."; exit 1; }
  RESOLVED="$(canonicalize_path "${DESTINATION}" 2>/dev/null || true)"
  [[ "${RESOLVED}" == "${STACK_ENTRYPOINT}" ]] || { prompt -e "Il link appartiene a un'altra installazione."; exit 1; }
  rm -f -- "${DESTINATION}"
fi
ln -s -- "${STACK_ENTRYPOINT}" "${DESTINATION}"

if [[ "${ACTIVATE}" == "true" ]]; then
  install_shell_integration "${FINAL_NAME}" "${SHELL_NAME}" "${TARGET}"
  prompt -i "Integrazione ${SHELL_NAME} installata; apri una nuova shell."
elif [[ ":${PATH}:" != *":${TARGET}:"* ]]; then
  prompt -i "Per questa sessione: export PATH=\"${TARGET}:\$PATH\""
fi
prompt -s "Installazione completata: ${DESTINATION}"
