#!/usr/bin/env bash
# @cli.summary: Disabilita uno o più servizi opzionali
# @cli.usage: SERVICE...
# @cli.argument: SERVICE... | optional-service | repeatable | Servizi opzionali da disabilitare

importLib "lib/lib-docker.sh"
shift
[[ $# -gt 0 ]] || { prompt -e "Indica almeno un servizio."; exit 2; }
REQUESTED_SERVICES=("$@")
for SERVICE_NAME in "${REQUESTED_SERVICES[@]}"; do
  isOptionalService "${SERVICE_NAME}" || { prompt -e "Servizio opzionale sconosciuto: ${SERVICE_NAME}"; exit 2; }
done
for SERVICE_NAME in "${REQUESTED_SERVICES[@]}"; do
  if isServiceEnabled "${SERVICE_NAME}"; then
    dockerCompose stop "${SERVICE_NAME}" || true
    dockerCompose rm -f "${SERVICE_NAME}" || true
    disableService "${SERVICE_NAME}"
  fi
done
dockerCompose up -d
prompt -s "Servizi disabilitati: ${REQUESTED_SERVICES[*]}"
