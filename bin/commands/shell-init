#!/usr/bin/env bash
# @cli.summary: Stampa completion e wrapper cd per la sessione corrente
# @cli.usage: SHELL
# @cli.argument: SHELL | enum(bash,zsh) | required | Shell da configurare

importLib "lib/lib-shell-integration.sh"
shift
[[ $# -eq 1 ]] || { prompt -e "Indica bash oppure zsh."; exit 2; }
case "$1" in bash | zsh) render_shell_init "${STACK_COMMAND_NAME}" "$1" ;; *) prompt -e "Shell non supportata: $1"; exit 2 ;; esac
