#!/usr/bin/env bash
# @cli.summary: Aggiorna il core dello stack preservando i dati utente
# @cli.usage: [OPTIONS...]
# @cli.option: -v, --version | text | TAG | Installa una release specifica
# @cli.option: -f, --force | flag | | Reinstalla una release già presente

shift
REPOSITORY="GDRCD/stack"
VERSION_FILE="${STACK_DIR}/.version"
VERSION_TAG=""; FORCE_UPGRADE="false"
PRESERVED_PATHS=(.env www logs services .git .version)
while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --version) require_option_value "$1" "${2:-}" || exit $?; VERSION_TAG="$2"; shift 2 ;;
    -f | --force) FORCE_UPGRADE="true"; shift ;;
    *) messageUnknownCommand upgrade "$1"; exit 2 ;;
  esac
done

installedVersion() { [[ ! -f "${VERSION_FILE}" ]] || head -n 1 "${VERSION_FILE}" | tr -d '[:space:]'; }
latestVersion() {
  local url tag
  url="$(curl -fsSL -o /dev/null -w '%{url_effective}' "https://github.com/${REPOSITORY}/releases/latest")" || return 1
  tag="${url##*/}"; case "${tag}" in v[0-9]*) printf '%s\n' "${tag}" ;; *) return 1 ;; esac
}
defaultBranch() {
  local ref
  ref="$(git -C "${STACK_DIR}" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" || return 1
  printf '%s\n' "${ref#origin/}"
}

upgradeArchive() {
  command -v curl >/dev/null 2>&1 || { prompt -e "curl non è installato."; return 1; }
  command -v tar >/dev/null 2>&1 || { prompt -e "tar non è installato."; return 1; }
  local current staging backup entry name
  current="$(installedVersion)"
  if [[ -z "${VERSION_TAG}" ]]; then VERSION_TAG="$(latestVersion)" || { prompt -e "Impossibile determinare l'ultima release."; return 1; }; fi
  if [[ "${current}" == "${VERSION_TAG}" && "${FORCE_UPGRADE}" != "true" ]]; then prompt -s "Stack già aggiornato (${current})."; return; fi
  staging="$(mktemp -d "${STACK_DIR}/.stack-upgrade.XXXXXX")" || return 1
  STAGING="${staging}"; trap 'rm -rf -- "${STAGING:-}"' EXIT
  prompt -i "Download di ${VERSION_TAG}..."
  curl -fsSL "https://github.com/${REPOSITORY}/archive/refs/tags/${VERSION_TAG}.tar.gz" |
    tar -xzf - -C "${staging}" --strip-components=1
  for entry in stack bin .docker; do [[ -e "${staging}/${entry}" ]] || { prompt -e "Archivio incompleto: ${entry}"; return 1; }; done
  backup="${STACK_DIR}/.stack-backup-${current:-unknown}-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "${backup}"
  for entry in "${staging}"/* "${staging}"/.[!.]*; do
    [[ -e "${entry}" ]] || continue
    name="$(basename "${entry}")"
    containsValue "${name}" "${PRESERVED_PATHS[@]}" && continue
    [[ ! -e "${STACK_DIR}/${name}" ]] || mv "${STACK_DIR}/${name}" "${backup}/${name}"
    mv "${entry}" "${STACK_DIR}/${name}"
  done
  chmod +x "${STACK_DIR}/stack" "${STACK_DIR}/boot.sh" "${STACK_DIR}"/bin/commands/*
  printf '%s\n' "${VERSION_TAG}" >"${VERSION_FILE}"
  prompt -s "Aggiornamento completato: ${VERSION_TAG}"
}

upgradeGit() {
  command -v git >/dev/null 2>&1 || { prompt -e "git non è installato."; return 1; }
  [[ -z "$(git -C "${STACK_DIR}" status --porcelain)" ]] || {
    prompt -e "Il working tree contiene modifiche. Salvale o rimuovile prima dell'upgrade."
    return 1
  }
  local branch
  branch="$(git -C "${STACK_DIR}" rev-parse --abbrev-ref HEAD)"
  git -C "${STACK_DIR}" fetch --tags --quiet
  if [[ -n "${VERSION_TAG}" ]]; then
    git -C "${STACK_DIR}" checkout --quiet "${VERSION_TAG}"
  else
    if [[ "${branch}" == "HEAD" ]]; then branch="$(defaultBranch)" || { prompt -e "Branch predefinito non determinabile."; return 1; }; fi
    git -C "${STACK_DIR}" checkout --quiet "${branch}"
    git -C "${STACK_DIR}" pull --ff-only --quiet
  fi
  prompt -s "Aggiornamento Git completato."
}

if [[ -d "${STACK_DIR}/.git" ]]; then upgradeGit; else upgradeArchive; fi
