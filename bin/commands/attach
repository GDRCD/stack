#!/usr/bin/env bash
# @cli.summary: Apre una shell nel container di un servizio
# @cli.usage: SERVICE
# @cli.argument: SERVICE | service | required | Servizio a cui collegarsi

importLib "lib/lib-docker.sh"
shift
SERVICE_NAME="${1:-}"
[[ $# -eq 1 ]] || { prompt -e "È richiesto esattamente un servizio."; exit 2; }
isServiceEnabled "${SERVICE_NAME}" || { prompt -e "Servizio non abilitato: ${SERVICE_NAME}"; exit 2; }
isContainerExist "${SERVICE_NAME}"
isContainerRunning "${SERVICE_NAME}"
prompt -i "Accesso al container ${SERVICE_NAME}..."
dockerCompose exec -it "${SERVICE_NAME}" sh
