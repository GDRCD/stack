#!/usr/bin/env bash

importLib "lib/lib-docker.sh"

# ---------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------

# Get current file name
CURRENT_FILE_NAME="$(basename "${BASH_SOURCE[0]}")"

# Save command name
args=("$@")
COMMAND_NAME="${args[0]}"
SERVICE_NAMES=()
# ---------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------

# Function for showing usage of this command
usage() {
  helpify_title "start" "[OPTIONS...] [<service>...]"
  helpify_subtitle "Start all containers or only the specified ones"; echo;
  helpify_subtitle "OPTIONS:"
  helpify "-h, --help" "Show this help"
}

# Function for showing usage of this command for help
usage4help() {
  helpify "start" "Start all containers or only the specified ones"
}

# ---------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------

#---------------------------PARSE ARGUMENTS-------------------------------#

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
  "${COMMAND_NAME}")
    shift
    ;; # Skip the command name
  -h | --help)
    need_help="true"
    shift
    ;;
  *)
    if isServiceCommand $1; then
      SERVICE_NAMES+=("$1")
      shift
    else
      messageUnknownCommand "$COMMAND_NAME" "$1"
      exit 1
    fi
    ;;
  esac
done

# Execute post argument parsing checks
finalize_argument_parsing

#---------------------------RUN COMMAND-------------------------------#

start() {

  if [[ ${#SERVICE_NAMES[@]} -eq 0 ]]; then
    # Preliminary checks
    isContainerExist
    prompt -i "Starting all containers..."
    dockerCompose start
  else
    for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do
      isContainerExist "${SERVICE_NAME}"
      prompt -i "Starting container '${SERVICE_NAME}' ...\n"
      dockerCompose start "${SERVICE_NAME}"
    done
  fi
}

# Run command if this file is the command file
if [[ "${COMMAND_NAME}" == "${CURRENT_FILE_NAME}" ]]; then
  start
fi
