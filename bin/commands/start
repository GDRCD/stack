#!/usr/bin/env bash
# @cli.summary: Avvia tutti i container o quelli indicati
# @cli.usage: [SERVICE...]
# @cli.argument: SERVICE... | service | repeatable | Servizi da avviare

importLib "lib/lib-docker.sh"
shift
SERVICE_NAMES=("$@")
for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isServiceEnabled "${SERVICE_NAME}" || { messageUnknownCommand start "${SERVICE_NAME}"; exit 2; }; done
if [[ ${#SERVICE_NAMES[@]} -eq 0 ]]; then isContainerExist; dockerCompose start; else
  for SERVICE_NAME in "${SERVICE_NAMES[@]}"; do isContainerExist "${SERVICE_NAME}"; dockerCompose start "${SERVICE_NAME}"; done
fi
