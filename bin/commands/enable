#!/usr/bin/env bash
# @cli.summary: Abilita uno o più servizi opzionali
# @cli.usage: SERVICE...
# @cli.argument: SERVICE... | optional-service | repeatable | Servizi opzionali da abilitare

importLib "lib/lib-docker.sh"
shift
[[ $# -gt 0 ]] || { prompt -e "Indica almeno un servizio."; exit 2; }
REQUESTED_SERVICES=("$@")
for SERVICE_NAME in "${REQUESTED_SERVICES[@]}"; do
  isOptionalService "${SERVICE_NAME}" || { prompt -e "Servizio opzionale sconosciuto: ${SERVICE_NAME}"; exit 2; }
done
for SERVICE_NAME in "${REQUESTED_SERVICES[@]}"; do enableService "${SERVICE_NAME}"; done
dockerCompose up -d
prompt -s "Servizi abilitati: ${REQUESTED_SERVICES[*]}"
